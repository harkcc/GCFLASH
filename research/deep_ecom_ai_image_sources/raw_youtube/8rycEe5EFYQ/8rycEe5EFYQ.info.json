pts, making professional product imagery accessible to small businesses, Etsy sellers, and Amazon merchants.\n\nIf you sell online, this could completely change your workflow.\n\nSubscribe for more such AI breakdowns made for everyone.\n\nGeetika Mehta Profile: https://www.linkedin.com/in/geetika-mehta-1000/\nSubscribe to my weekly AI Newsletter: https://nanobits.beehiiv.com/\n\n#ProductPhotography #Ecommerce #AItools #NanoBanana #SmallBusiness", "channel_id": "UCSMGFKfjPOcYHSC0uhmk1sA", "channel_url": "https://www.youtube.com/channel/UCSMGFKfjPOcYHSC0uhmk1sA", "duration": 28, "view_count": 2984, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=8rycEe5EFYQ", "categories": ["Science & Technology"], "tags": [], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 1, "like_count": 33, "channel": "Nanobits", "channel_follower_count": 166, "uploader": "Nanobits", "uploader_id": "@The-Nano-bits", "uploader_url": "https://www.youtube.com/@The-Nano-bits", "upload_date": "20250921", "timestamp": 1758422888, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtube.com", "extractor": "youtube", "extractor_key": "Youtube", "display_id": "8rycEe5EFYQ", "fulltitle": "Professional Product Photography with AI | E-Commerce Images Using Google Nano Banana", "duration_string": "28", "is_live": false, "was_live": false, "epoch": 1779471363, "asr": 22050, "filesize": 351462, "format_id": "18", "format_note": "360p", "source_preference": -1, "fps": 30, "audio_channels": 2, "height": 360, "quality": 6.0, "has_drm": false, "tbr": 99.911, "filesize_approx": 351461, "width": 640, "language_preference": -1, "ext": "mp4", "vcodec": "avc1.42001E", "acodec": "mp4a.40.2", "dynamic_range": "SDR", "url": "https://rr1---sn-o097znze.googlevideo.com/video