  "canvas_size": [1024, 1024],

  "mask_params": {
    "feather_radius_px": 4,
    "shrink_erode_px":   1,
    "reason": "电子产品硬边锐利，羽化不宜大；erode 1px 防止白边残留"
  },

  "prompt_fragments": {
    "positive_style_base": "professional product photography, industrial catalog style, dramatic rim lighting, hyper-realistic material rendering, 8K resolution, commercial quality",
    "positive_mood": "practical, powerful, trustworthy, working-class confidence",
    "negative_base": "cartoon, toy-like, cheap plastic, low quality, blurry, watermark, overexposed, distorted product, wrong logo, extra buttons, missing display",
    "scene_pool": [
      "dark garage with concrete floor",
      "empty rural road at dusk",
      "home driveway at golden hour",
      "roadside shoulder with hazard lights",
      "parking lot at night with street lamps",
      "mountain bike trail",
      "indoor basketball court",
      "motorcycle meetup golden hour"
    ],
    "human_presence": "minimal — silhouette or hands only; avoid close-up faces"
  },

  "typography": {
    "headline_font": "Inter Black / Bebas Neue / Helvetica Bold",
    "headline_case": "UPPERCASE",
    "headline_weight": 900,
    "subtext_font": "Inter Medium",
    "subtext_case": "Sentence case",
    "max_headline_words": 6,
    "max_subtext_words": 15,
    "contrast_min_ratio": 7.0
  },

  "quality_rubric": {
    "product_fidelity_weight": 0.35,
    "text_legibility_weight":  0.20,
    "composition_weight":      0.15,
    "lighting_weight":         0.15,
    "brand_consistency_weight":0.15,
    "pass_threshold": 7.0
  },

  "8_image_sequence_default": [
    "hero",
    "pain_point",
    "solution",
    "detail",
    "scene_multi_use",
    "trust",
    "specs",
    "cta_gift"
  ],

  "notes_for_future": [
    "首次验证用例。参数基于 ST08 调，后续接入 headphone / dashcam 等子品类时需复核光源参数和 mask_params",
    "pain_point 图不显示产品，scene_multi_use 需要 In-Context-LoRA 保持跨场景一致性",
    "规格图优先用 HTML 模板叠字（Playwright），避免 Ideogram/Qwen 小字乱码"
  ]
