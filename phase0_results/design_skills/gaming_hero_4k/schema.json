{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gaming_hero_4k inputs",
  "type": "object",
  "required": ["background_image_url", "hero_number", "brand_name"],
  "properties": {
    "background_image_url": {
      "type": "string",
      "description": "URL or local file path (file://) to hero composite background"
    },
    "hero_number": {
      "type": "string",
      "maxLength": 6,
      "description": "Big spec number (e.g., 4K, 150PSI)"
    },
    "brand_name": {
      "type": "string",
      "maxLength": 16,
      "description": "Brand wordmark"
    },
    "brand_color": { "type": "string", "default": "#E11" },
    "badge_text": { "type": "string", "maxLength": 12 },
    "badge_color": { "type": "string", "default": "#1E90FF" },
    "spec_line_1": { "type": "string", "maxLength": 20 },
    "spec_line_2": { "type": "string", "maxLength": 20 },
    "canvas_size": { "type": "integer", "default": 1024, "enum": [1024, 2048] }
  }
}
